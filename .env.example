# Runtime mode: demo or live. Production refuses demo mode.
APP_MODE=demo
VITE_APP_MODE=demo
PORT=3001
BUSINESS_ID=velo
BUSINESS_TIMEZONE=Asia/Dubai

# Firebase web client configuration (public project identifiers, not secrets)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server project configuration. Use Application Default Credentials in live mode.
FIREBASE_PROJECT_ID=
DEVELOPMENT_PROJECT_ID=
ALLOW_DEMO_SEED=false
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
ALLOWED_ORIGINS=http://localhost:5173
